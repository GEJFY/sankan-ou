# ============================================
# Stage 1: Build
# ============================================
# NOTE: there used to be a separate "deps" stage here running
# `npm ci --omit=dev` that nothing referenced - this "builder" stage always
# did its own independent `npm ci`. It has been removed rather than wired in,
# because `next build` needs devDependencies (typescript, tailwindcss,
# @types/*) that `--omit=dev` deliberately excludes, so reusing that stage's
# node_modules would have broken the build. The runtime stage below never
# touches node_modules directly either - it only copies the Next.js
# "standalone" output, which bundles its own minimal runtime deps.
FROM node:20-slim AS builder
WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json* ./
RUN npm ci
COPY apps/web/ .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV PATH="/app/node_modules/.bin:$PATH"

RUN chmod -R +x node_modules/.bin/ && node node_modules/next/dist/bin/next build

# ============================================
# Stage 2: Runtime
# ============================================
FROM node:20-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 3000
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
